# --- Server ---
PORT=4000
NODE_ENV=development

# Postgres connection string (Neon / Supabase free tier, or local).
# Get one at https://neon.tech or https://supabase.com — never commit the real value.
DATABASE_URL=postgres://user:password@host:5432/starforge

# Secret used to sign session/auth tokens. Generate with: openssl rand -base64 48
AUTH_SECRET=dev-placeholder-change-me

# --- Web ---
VITE_WS_URL=ws://localhost:4000/ws
VITE_API_URL=http://localhost:4000
